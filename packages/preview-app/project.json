{
  "name": "preview-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/preview-app/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{workspaceRoot}/preview/app.js"
      ],
      "options": {
        "command": "esbuild packages/preview-app/src/app.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=preview/app.js"
      }
    }
  },
  "tags": [
    "scope:preview",
    "type:application"
  ]
}
