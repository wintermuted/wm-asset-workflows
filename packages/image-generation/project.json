{
  "name": "image-generation",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/image-generation/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "main": "packages/image-generation/src/generate-images.ts",
        "outputPath": "dist/packages/image-generation",
        "tsConfig": "packages/image-generation/tsconfig.json"
      }
    },
    "generate-png": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "{workspaceRoot}/outputs/png"
      ],
      "options": {
        "command": "node dist/packages/image-generation/src/generate-images.js"
      }
    }
  },
  "tags": [
    "scope:images",
    "type:application"
  ]
}
