{
  "name": "agentic-icon-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "description": "Agentic Icon Builder for SVG-first logo and glyph workflows, previews, and exports.",
  "scripts": {
    "nx": "nx",
    "graph": "nx graph",
    "build": "nx run-many -t build",
    "install:deps": "node scripts/node/install-deps.mjs",
    "preview": "npm run ensure:deps && nx run preview-server:serve",
    "ensure:deps": "node scripts/node/ensure-deps.mjs",
    "build:specs": "nx run workflows:build-specs",
    "generate:png": "nx run image-generation:generate-png",
    "capture": "nx run workflows:capture",
    "workflow:logo": "nx run workflows:logo",
    "ui-theme:link-local": "cd ../wintermuted-ui-theme && npm link && cd - && npm link @wintermuted/ui-theme",
    "ui-theme:unlink-local": "npm unlink --no-save @wintermuted/ui-theme && npm install"
  },
  "dependencies": {
    "@wintermuted/ui-theme": "^0.21.4",
    "lucide": "^0.577.0"
  },
  "devDependencies": {
    "@nx/js": "^21.4.1",
    "@types/node": "^20.19.11",
    "esbuild": "^0.25.9",
    "nx": "^21.4.1",
    "playwright": "^1.54.0",
    "typescript": "^5.8.3"
  }
}
